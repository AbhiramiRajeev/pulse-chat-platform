# Copy this file to .env and fill in the values before running docker compose.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose -f deployments/docker-compose.yaml up --build

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pulse_chat
# Optional host-side port override; containers still use PostgreSQL port 5432.
POSTGRES_HOST_PORT=5433

# MongoDB
MONGO_DATABASE=pulse_chat
MONGO_HOST_PORT=27017

# Optional host-side service port overrides
REDIS_HOST_PORT=6379
GRPC_HOST_PORT=50051
HTTP_HOST_PORT=8080

# JWT — change this to a long random string in production
JWT_SECRET=changeme-secret-key
JWT_EXPIRY=24h
